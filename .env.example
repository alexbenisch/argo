# Copy to .env and fill in. .env is gitignored — keep it that way, this repo is public.

# Hetzner Cloud API token for the dedicated argo-playground project.
# Read+Write. https://console.hetzner.cloud → Project → Security → API tokens
HCLOUD_TOKEN=

# Cloudflare API token scoped to the kubetest.uk zone.
# Needs Zone:DNS:Edit (used for both the A records and cert-manager's DNS-01 challenge).
CLOUDFLARE_KUBETEST_API_TOKEN=
